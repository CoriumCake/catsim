{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catsim",
  "compatibility_date": "2026-10-01",
  // Static site only: the Vite build output (run `npm run build` first). Headers live in public/_headers.
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "sim.catcodehq.com", "custom_domain": true }
  ]
}
